{
  "compilerOptions": {
    "types": ["@graphprotocol/graph-ts"],
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "dist",
    "noImplicitAny": false,
    "baseUrl": "."
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules"]
}